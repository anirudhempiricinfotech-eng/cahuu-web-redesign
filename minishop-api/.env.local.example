NODE_ENV=local
PORT=3100
DATABASE_URL=postgresql://MINISHOP_DB_USER:MINISHOP_DB_PASSWORD@MINISHOP_DB_HOST:5432/MINISHOP_DB_NAME
JWT_PUBLIC_KEY_PATH=./keys/local-public.pem
JWT_PRIVATE_KEY_PATH=./keys/local-private.pem
REDIS_URL=redis://MINISHOP_REDIS_HOST:6379
PAYMENT_PROVIDER_API_KEY=REPLACE_WITH_LOCAL_PAYMENT_PROVIDER_KEY
LOG_LEVEL=debug

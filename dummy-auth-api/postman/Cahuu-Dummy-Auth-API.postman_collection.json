{
  "info": {
    "_postman_id": "2e07f2b6-15f4-4938-86cb-3652d321604b",
    "name": "Cahuu Dummy Auth API",
    "description": "Fictional local Auth API collection. The API runs only from dummy-auth-api and all tokens are ephemeral development values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup — success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.session.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.session.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maya Shah\",\n  \"email\": \"maya.shah@example.test\",\n  \"password\": \"RiverStone8\",\n  \"acceptTerms\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "signup"] }
          },
          "response": []
        },
        {
          "name": "Signup — validation failure",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Validation error', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maya Shah\",\n  \"email\": \"maya.shah@example.test\",\n  \"password\": \"weak\",\n  \"acceptTerms\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "signup"] }
          },
          "response": []
        },
        {
          "name": "Login — seeded dummy user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logged in', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.session.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.session.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.mehta@example.test\",\n  \"password\": \"CahuuDemo9\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "Login — unauthorized",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Unauthorized', () => pm.response.to.have.status(401));", "pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');"], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.mehta@example.test\",\n  \"password\": \"WrongPass9\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rotated', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.session.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.session.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          },
          "response": []
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav.mehta@example.test\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot-password"] }
          },
          "response": []
        },
        {
          "name": "Reset password — seeded dummy token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"dummy-reset-token-aarav-2026\",\n  \"newPassword\": \"NewCahuuPass7\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password"] }
          },
          "response": []
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/session", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "session"] }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/session", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "session"] }
          },
          "response": []
        }
      ]
    }
  ]
}
